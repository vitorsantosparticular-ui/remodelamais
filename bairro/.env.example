# Copiar para apps/server/.env e ajustar
DATABASE_URL="postgresql://bairro:bairro@localhost:5432/bairro?schema=public"
# Opcional: sem REDIS_URL o servidor usa memória local (só serve para 1 instância)
REDIS_URL="redis://localhost:6379"
PORT=3001
# Origem do cliente em desenvolvimento (Vite)
WEB_ORIGIN="http://localhost:5173"
# Em produção: true (cookies só por HTTPS)
COOKIE_SECURE=false
LOG_LEVEL=info
