{
  "name": "@bairro/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@bairro/shared": "*",
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "8.1.1",
    "@prisma/client": "6.5.0",
    "fastify": "5.2.1",
    "ioredis": "5.6.0",
    "pino": "9.6.0",
    "socket.io": "4.8.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "prisma": "6.5.0",
    "socket.io-client": "4.8.1",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
}