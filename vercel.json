{
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.soniasantosadvogada.pt" }], "destination": "https://soniasantosadvogada.pt/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "drasoniasantos.pt" }], "destination": "https://soniasantosadvogada.pt/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.drasoniasantos.pt" }], "destination": "https://soniasantosadvogada.pt/:path*", "permanent": true },
    { "source": "/README.md", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
